# backend/.env.example: every variable the API reads. For local development:
#   cp .env.example .env
# .env is git-ignored. On the server the same variables come from
# /srv/guestbook/.env.staging and .env.production, written by CI (lesson 2.3).

# development | staging | production (separate from NODE_ENV)
APP_ENV=development

# Port the API listens on; Vite proxies /api here in development
PORT=3000

# Postgres from infra/compose/dev.yml
DATABASE_URL=postgres://guestbook:guestbook@localhost:5432/guestbook

# Shown in the footer and in every log line; CI sets it to the commit SHA
APP_VERSION=dev

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
