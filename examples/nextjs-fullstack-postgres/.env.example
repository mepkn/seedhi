# .env.example: every variable the app reads. For local development:
#   cp .env.example .env
# .env is git-ignored. On the server the same variables come from
# /srv/guestbook/.env.staging and .env.production, written by CI (lesson 2.3).

# development | staging | production (separate from NODE_ENV)
APP_ENV=development

# Postgres from infra/compose/dev.yml. 127.0.0.1, not localhost: localhost
# also resolves to ::1, where nothing listens, and the failed attempt becomes
# an AggregateError that crashes `next dev` while the database is down.
DATABASE_URL=postgres://guestbook:guestbook@127.0.0.1:5432/guestbook

# Shown in the footer and in every log line; CI sets it to the commit SHA
APP_VERSION=dev

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Port: `next dev` and `next start` listen on 3000; pass -p (or PORT) to change it.
