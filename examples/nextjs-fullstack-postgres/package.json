{
  "name": "seedhi-nextjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev | pino-pretty",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
